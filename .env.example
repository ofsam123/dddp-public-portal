# Server-side only. Do not prefix these values with REACT_APP_.
DDDP_API_BASE_URL=https://your-private-dddp-host.example/api
DDDP_API_USERNAME=
DDDP_API_PASSWORD=

# DPAT performance analysis (server-side only).
CMS_BASE_URL=https://dddpcms.aoinnovations.org/dddp/api/v1/
CMS_USER=
CMS_PASS=
# Defaults to the DDDP_API_* values when omitted.
DHIS2_BASE_URL=https://dddp.gov.gh/api
DHIS2_USER=
DHIS2_PASS=
# "official" (Excellent 75+/Very Good 60+/Good 40+/Fair 30+/Poor) or "standard" (…/Fair/Poor).
DPAT_CLASSIFICATION_SCALE=official
# Optional comma-separated allow-list of years to publish (e.g. 2025). Empty = every year with completed assessments.
DPAT_PUBLISHED_YEARS=
DPAT_UPSTREAM_CONCURRENCY=20
DPAT_SCORES_CACHE_TTL_MS=1800000

# Optional server settings.
PORT=3001
PUBLIC_GEOGRAPHY_CACHE_TTL_MS=900000
